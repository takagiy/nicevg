<svg xmlns="http://www.w3.org/2000/svg" viewBox="-150 0 1438 2060" width="1438" height="2060">

  <style>
    text { font-family: system-ui, sans-serif; fill: #1f2937; }
    .title { font-size: 20px; font-weight: 700; }
    .caption { font-size: 12px; fill: #6b7280; }
    .container &gt; rect { fill: #f8fafc; stroke: #94a3b8; stroke-dasharray: 6 4; }
    .container &gt; text { font-size: 13px; font-weight: 600; fill: #475569; }
    .actor circle { fill: #fef3c7; stroke: #b45309; stroke-width: 1.5; }
    .client rect { fill: #e0f2fe; stroke: #0369a1; }
    .edge rect { fill: #ede9fe; stroke: #6d28d9; }
    .service rect { fill: #dcfce7; stroke: #15803d; }
    .store rect { fill: #ffedd5; stroke: #c2410c; }
    .external rect { fill: #f1f5f9; stroke: #334155; stroke-width: 2; }
    .process circle { fill: #dbeafe; stroke: #1d4ed8; stroke-width: 1.5; }
    .entity rect { fill: #fef3c7; stroke: #92400e; stroke-width: 2; }
    .datastore rect { fill: #f0fdf4; stroke: #166534; }
    .flow { stroke: #475569; stroke-width: 1.4; marker-end: url(#arrow); }
    .flow-label { font-size: 11px; fill: #334155; font-style: italic; }
  </style>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#475569"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="100%" height="100%" fill="#ffffff"/>
  <text data-label="title" class="title" x="24" y="40" font-size="20">Loan origination — data flow diagram (level 1)</text>
  <text data-label="caption" class="caption" x="24" y="62" font-size="12">From application to payout: nested parallel checks, a manual review branch and flows that skip ahead</text>
  <g data-node="applicant" class="entity">
    <rect x="470" y="90" width="140" height="52" rx="6"/>
    <text x="540" y="121" text-anchor="middle" font-size="13">Applicant</text>
  </g>
  <g data-node="idp" class="entity">
    <rect x="898" y="400" width="154" height="52" rx="6"/>
    <text x="975" y="431" text-anchor="middle" font-size="13">Identity provider</text>
  </g>
  <g data-node="bureau" class="entity">
    <rect x="40" y="655" width="130" height="52" rx="6"/>
    <text x="105" y="686" text-anchor="middle" font-size="13">Credit bureau</text>
  </g>
  <g data-node="underwriter" class="entity" transform="translate(0 20)">
    <rect x="1010" y="1115" width="130" height="52" rx="6"/>
    <text x="1075" y="1146" text-anchor="middle" font-size="13">Underwriter</text>
  </g>
  <g data-node="bank" class="entity">
    <rect x="900" y="1630" width="130" height="52" rx="6"/>
    <text x="965" y="1661" text-anchor="middle" font-size="13">Payout bank</text>
  </g>
  <g data-node="messaging" class="entity">
    <rect x="463" y="1970" width="154" height="52" rx="6"/>
    <text x="540" y="2001" text-anchor="middle" font-size="13">Messaging service</text>
  </g>
  <g data-node="intake" class="process">
    <circle cx="540" cy="250" r="82"/>
    <text x="540" y="255" text-anchor="middle" font-size="13">1 Take application</text>
  </g>
  <g data-node="verify" class="process">
    <circle cx="540" cy="425" r="78"/>
    <text x="540" y="430" text-anchor="middle" font-size="13">2 Verify identity</text>
  </g>
  <g data-node="credit" class="process">
    <circle cx="380" cy="680" r="67"/>
    <text x="380" y="685" text-anchor="middle" font-size="13">3 Check credit</text>
  </g>
  <g data-node="screen" class="process">
    <circle cx="720" cy="590" r="82"/>
    <text x="720" y="595" text-anchor="middle" font-size="13">4 Screen applicant</text>
  </g>
  <g data-node="sanctions" class="process">
    <circle cx="600" cy="780" r="78"/>
    <text x="600" y="785" text-anchor="middle" font-size="13">5 Check sanctions</text>
  </g>
  <g data-node="fraud" class="process" transform="translate(-57 0)">
    <circle cx="840" cy="780" r="63"/>
    <text x="840" y="785" text-anchor="middle" font-size="13">6 Score fraud</text>
  </g>
  <g data-node="assess" class="process">
    <circle cx="540" cy="960" r="63"/>
    <text x="540" y="965" text-anchor="middle" font-size="13">7 Assess risk</text>
  </g>
  <g data-node="review" class="process">
    <circle cx="760" cy="1140" r="63"/>
    <text x="760" y="1145" text-anchor="middle" font-size="13">8 Review case</text>
  </g>
  <g data-node="offer" class="process">
    <circle cx="540" cy="1310" r="60"/>
    <text x="540" y="1315" text-anchor="middle" font-size="13">9 Make offer</text>
  </g>
  <g data-node="sign" class="process">
    <circle cx="540" cy="1480" r="75"/>
    <text x="540" y="1485" text-anchor="middle" font-size="13">10 Sign contract</text>
  </g>
  <g data-node="payout" class="process">
    <circle cx="540" cy="1655" r="58"/>
    <text x="540" y="1660" text-anchor="middle" font-size="13">11 Pay out</text>
  </g>
  <g data-node="notify" class="process">
