---
source: tests/arrange.rs
expression: result.svg.as_str()
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1830 1260" width="1830" height="1260">

  <style>
    text { font-family: system-ui, sans-serif; }
    .title { font-size: 22px; font-weight: 700; fill: #111827; }
    .caption { font-size: 12px; fill: #4b5563; }
    .person rect { fill: #08427b; stroke: #052e56; }
    .container rect { fill: #438dd5; stroke: #3c7fc0; }
    .database rect { fill: #438dd5; stroke: #3c7fc0; stroke-width: 2; stroke-dasharray: 2 2; }
    .external rect { fill: #999999; stroke: #8a8a8a; }
    .person text, .container text, .database text, .external text { fill: #ffffff; }
    .name { font-weight: 700; }
    .boundary &gt; rect { fill: none; stroke: #444444; stroke-dasharray: 8 4; }
    .boundary &gt; text { fill: #444444; font-size: 13px; }
    .rel { stroke: #707070; stroke-width: 1.3; marker-end: url(#arrow); }
    .rel-label { fill: #707070; font-size: 11px; }
  </style>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#707070"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="100%" height="100%" fill="#ffffff"/>
  <text data-label="title" class="title" x="40" y="44" font-size="22">Food Delivery Platform — Container diagram</text>
  <text data-label="caption" class="caption" x="40" y="68" font-size="12">C4 level 2: the apps, services and data stores inside the platform, and the people and systems around it</text>
  <g data-node="customer" class="person">
    <rect x="90" y="100" width="210" height="92" rx="28"/>
    <text x="195" y="126" text-anchor="middle"><tspan x="195" dy="0" class="name" font-size="14">Customer</tspan><tspan x="195" dy="18" class="tag" font-size="11">[Person]</tspan><tspan x="195" dy="16" class="description" font-size="11">Orders food and tracks it</tspan></text>
  </g>
  <g data-node="staff" class="person">
    <rect x="470" y="100" width="210" height="92" rx="28"/>
    <text x="575" y="126" text-anchor="middle"><tspan x="575" dy="0" class="name" font-size="14">Restaurant staff</tspan><tspan x="575" dy="18" class="tag" font-size="11">[Person]</tspan><tspan x="575" dy="16" class="description" font-size="11">Prepares orders</tspan></text>
  </g>
  <g data-node="courier" class="person">
    <rect x="850" y="100" width="210" height="92" rx="28"/>
    <text x="955" y="126" text-anchor="middle"><tspan x="955" dy="0" class="name" font-size="14">Courier</tspan><tspan x="955" dy="18" class="tag" font-size="11">[Person]</tspan><tspan x="955" dy="16" class="description" font-size="11">Picks up and delivers</tspan></text>
  </g>
  <g data-node="agent" class="person">
    <rect x="1230" y="100" width="210" height="92" rx="28"/>
    <text x="1335" y="126" text-anchor="middle"><tspan x="1335" dy="0" class="name" font-size="14">Support agent</tspan><tspan x="1335" dy="18" class="tag" font-size="11">[Person]</tspan><tspan x="1335" dy="16" class="description" font-size="11">Resolves complaints</tspan></text>
  </g>
  <g data-node="platform" class="boundary">
    <rect x="60" y="250" width="1410" height="841" rx="10"/>
    <text x="76" y="1076">Food Delivery Platform [Software System]</text>
    <g data-node="customer_app" class="container">
      <rect x="90" y="280" width="210" height="92" rx="6"/>
      <text x="195" y="306" text-anchor="middle"><tspan x="195" dy="0" class="name" font-size="14">Customer app</tspan><tspan x="195" dy="18" class="tag" font-size="11">[Container: React Native]</tspan><tspan x="195" dy="16" class="description" font-size="11">Browse, order, track</tspan></text>
    </g>
    <g data-node="portal" class="container" transform="translate(40 0)">
      <rect x="470" y="280" width="210" height="92" rx="6"/>
      <text x="575" y="306" text-anchor="middle"><tspan x="575" dy="0" class="name" font-size="14">Restaurant portal</tspan><tspan x="575" dy="18" class="tag" font-size="11">[Container: React SPA]</tspan><tspan x="575" dy="16" class="description" font-size="11">Menus and incoming orders</tspan></text>
    </g>
    <g data-node="courier_app" class="container">
      <rect x="850" y="280" width="210" height="92" rx="6"/>
      <text x="955" y="306" text-anchor="middle"><tspan x="955" dy="0" class="name" font-size="14">Courier app</tspan><tspan x="955" dy="18" class="tag" font-size="11">[Container: Kotlin, Swift]</tspan><tspan x="955" dy="16" class="description" font-size="11">Jobs and navigation</tspan></text>
    </g>
    <g data-node="console" class="container">
      <rect x="1230" y="280" width="210" height="92" rx="6"/>
      <text x="1335" y="306" text-anchor="middle"><tspan x="1335" dy="0" class="name" font-size="14">Admin console</tspan><tspan x="1335" dy="18" class="tag" font-size="11">[Container: React SPA]</tspan><tspan x="1335" dy="16" class="description" font-size="11">Refunds and disputes</tspan></text>
    </g>
    <g data-node="gateway" class="container">
      <rect x="560" y="440" width="300" height="92" rx="6"/>
      <text x="710" y="466" text-anchor="middle"><tspan x="710" dy="0" class="name" font-size="14">API gateway</tspan><tspan x="710" dy="18" class="tag" font-size="11">[Container: Kong]</tspan><tspan x="710" dy="16" class="description" font-size="11">Auth, rate limits, routing</tspan></text>
    </g>
    <g data-node="identity" class="container">
      <rect x="90" y="600" width="210" height="92" rx="6"/>
      <text x="195" y="626" text-anchor="middle"><tspan x="195" dy="0" class="name" font-size="14">Identity service</tspan><tspan x="195" dy="18" class="tag" font-size="11">[Container: Go]</tspan><tspan x="195" dy="16" class="description" font-size="11">Accounts and tokens</tspan></text>
    </g>
    <g data-node="orders" class="container">
      <rect x="380" y="600" width="210" height="92" rx="6"/>
      <text x="485" y="626" text-anchor="middle"><tspan x="485" dy="0" class="name" font-size="14">Order service</tspan><tspan x="485" dy="18" class="tag" font-size="11">[Container: Java, Spring]</tspan><tspan x="485" dy="16" class="description" font-size="11">Order lifecycle</tspan></text>
    </g>
    <g data-node="menu" class="container">
      <rect x="670" y="600" width="210" height="92" rx="6"/>
      <text x="775" y="626" text-anchor="middle"><tspan x="775" dy="0" class="name" font-size="14">Menu service</tspan><tspan x="775" dy="18" class="tag" font-size="11">[Container: Node.js]</tspan><tspan x="775" dy="16" class="description" font-size="11">Restaurants and menus</tspan></text>
    </g>
    <g data-node="dispatch" class="container">
      <rect x="960" y="600" width="210" height="92" rx="6"/>
      <text x="1065" y="626" text-anchor="middle"><tspan x="1065" dy="0" class="name" font-size="14">Dispatch service</tspan><tspan x="1065" dy="18" class="tag" font-size="11">[Container: Go]</tspan><tspan x="1065" dy="16" class="description" font-size="11">Assigns couriers</tspan></text>
    </g>
    <g data-node="payments" class="container">
      <rect x="1230" y="600" width="210" height="92" rx="6"/>
      <text x="1335" y="626" text-anchor="middle"><tspan x="1335" dy="0" class="name" font-size="14">Payment service</tspan><tspan x="1335" dy="18" class="tag" font-size="11">[Container: Java]</tspan><tspan x="1335" dy="16" class="description" font-size="11">Charges and refunds</tspan></text>
    </g>
    <g data-node="identity_db" class="database">
      <rect x="90" y="800" width="210" height="92" rx="6"/>
      <text x="195" y="826" text-anchor="middle"><tspan x="195" dy="0" class="name" font-size="14">Identity DB</tspan><tspan x="195" dy="18" class="tag" font-size="11">[Container: PostgreSQL]</tspan><tspan x="195" dy="16" class="description" font-size="11">Users, credentials</tspan></text>
    </g>
    <g data-node="order_db" class="database">
      <rect x="380" y="800" width="210" height="92" rx="6"/>
      <text x="485" y="826" text-anchor="middle"><tspan x="485" dy="0" class="name" font-size="14">Order DB</tspan><tspan x="485" dy="18" class="tag" font-size="11">[Container: PostgreSQL]</tspan><tspan x="485" dy="16" class="description" font-size="11">Orders, line items</tspan></text>
    </g>
    <g data-node="search" class="database">
      <rect x="670" y="800" width="210" height="92" rx="6"/>
      <text x="775" y="826" text-anchor="middle"><tspan x="775" dy="0" class="name" font-size="14">Search index</tspan><tspan x="775" dy="18" class="tag" font-size="11">[Container: Elasticsearch]</tspan><tspan x="775" dy="16" class="description" font-size="11">Menu search</tspan></text>
    </g>
    <g data-node="events" class="container">
      <rect x="960" y="800" width="210" height="92" rx="6"/>
      <text x="1065" y="826" text-anchor="middle"><tspan x="1065" dy="0" class="name" font-size="14">Event bus</tspan><tspan x="1065" dy="18" class="tag" font-size="11">[Container: Kafka]</tspan><tspan x="1065" dy="16" class="description" font-size="11">Order and courier events</tspan></text>
    </g>
    <g data-node="locations" class="database">
      <rect x="1230" y="800" width="210" height="92" rx="6"/>
      <text x="1335" y="826" text-anchor="middle"><tspan x="1335" dy="0" class="name" font-size="14">Location cache</tspan><tspan x="1335" dy="18" class="tag" font-size="11">[Container: Redis]</tspan><tspan x="1335" dy="16" class="description" font-size="11">Live courier positions</tspan></text>
    </g>
    <g data-node="notify" class="container">
      <rect x="670" y="960" width="210" height="92" rx="6"/>
      <text x="775" y="986" text-anchor="middle"><tspan x="775" dy="0" class="name" font-size="14">Notification service</tspan><tspan x="775" dy="18" class="tag" font-size="11">[Container: Python]</tspan><tspan x="775" dy="16" class="description" font-size="11">Push, SMS and email</tspan></text>
    </g>
