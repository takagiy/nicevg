{
  "name": "nicevg",
  "version": "0.15.0",
  "description": "Deterministic checks and repairs for diagrams, given as shapes or SVG, on Bun and Node through native FFI.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "native"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/takagiy/nicevg.git",
    "directory": "bindings/js"
  },
  "scripts": {
    "build": "bun run build:native && bun run build:js",
    "build:native": "bun run scripts/build-native.ts",
    "build:js": "tsc -p tsconfig.build.json",
    "test": "bun run test:bun && bun run test:node",
    "test:bun": "bun test ./test/bun",
    "test:node": "node --test \"test/node/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "koffi": "3.3.3"
  },
  "trustedDependencies": [
    "koffi"
  ],
  "main": "./dist/index.js"
}
